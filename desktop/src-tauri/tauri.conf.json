{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AirBridge",
  "version": "0.0.1",
  "identifier": "dev.tianrking.airbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AirBridge",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#f7f8fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Native file sharing through ESP32-S3",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
